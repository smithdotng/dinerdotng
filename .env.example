NODE_ENV=development
APP_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/dinerdotng

# Session cookie encryption - must be at least 32 characters, keep secret.
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# NOTE: this file is committed to git - keep only placeholders here. Put real
# values in .env.local, which is gitignored.

# --- Pricing ---
# Set to false to switch off the first-customer (first month) discount.
FIRST_CUSTOMER_PROMO=true

# --- Payments (Flutterwave) ---
# Secret key from Flutterwave dashboard > Settings > API keys (FLWSECK_TEST-... for test mode).
# Leave blank to run in demo mode: plans activate instantly without charging.
FLW_SECRET_KEY=
# Optional: secret hash set in Flutterwave > Settings > Webhooks (used by /api/flutterwave/webhook)
FLW_WEBHOOK_HASH=

# --- Photo storage ---
# On Vercel: connect a Blob store (Storage tab) and BLOB_READ_WRITE_TOKEN is added for you.
# Or use Cloudinary. With neither set, uploads go to ./uploads (local dev / VPS only).
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- First admin (used by `npm run create-admin`) ---
ADMIN_EMAIL=admin@diner.ng
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Diner.ng Admin
